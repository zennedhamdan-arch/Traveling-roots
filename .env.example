# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Both come from your Supabase project: Settings -> API.
#
# The site works WITHOUT these. Leave them unset and the public website renders
# from the committed content in data/ exactly as it does today; only /admin is
# unavailable. Set them to turn on the database and the dashboard.
#
# On Vercel these go in Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: there is deliberately NO service-role key here.
# This application never bypasses Row Level Security — the dashboard runs with
# the signed-in admin's own session, so there is exactly one authorization path
# and it is the one covered by `npm run db:test`. A service-role key in a
# Next.js app is one accidental "use client" away from being public.
